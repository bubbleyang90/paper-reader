{
  "name": "paper-reader",
  "version": "0.1.0",
  "private": true,
  "description": "纸页 — a quiet, lightweight Markdown reader powered by Rust",
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "scripts": {
    "start": "node scripts/preview.mjs",
